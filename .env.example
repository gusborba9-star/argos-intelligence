# ARGOS v6 — ENVIRONMENT VARIABLES (nomes conforme usados no código-fonte)
# Copy this file to .env and fill with your credentials

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# GOOGLE AI (GEMINI) — usado pelo RAGContextEngine
GOOGLE_AI_API_KEY=your_google_ai_api_key

# Sports Data
PROPLINE_API_KEY=your_propline_api_key
API_SPORTS_KEY=your_api_sports_key
NBA_API_KEY=your_nba_api_key

# Argos Internal API Key — protege /api/argos/v6/worker e /api/argos/v6/ingest
# Este MESMO valor deve ser configurado no Supabase (Vault/secrets) para o pg_net chamar essas rotas
ARGOS_API_KEY=your_secret_argos_api_key

# Telegram Bot (Dual-Channel Dispatch)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_FREE_CHANNEL_ID=your_free_channel_id    # Free tier signals
TELEGRAM_CHAT_ID=your_vip_channel_id             # VIP/WHALE tier signals

# Upstash Redis (Cache & State Management)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Payment Gateway — Efí (PIX)
EFI_CLIENT_ID=your_efi_client_id
EFI_CLIENT_SECRET=your_efi_client_secret
EFI_PIX_KEY=your_efi_pix_key
EFI_CERTIFICATE_BASE64=your_efi_certificate_base64
