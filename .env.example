# ARGOS v4.0 — ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env and fill with your credentials

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# GOOGLE AI (GEMINI)
GOOGLE_API_KEY=your_google_api_key

# API Football (Para Data Ingestion Service)
FOOTBALL_API_KEY=your_football_api_key

# Argos Internal API Key (Para proteger a rota /api/argos/v4)
ARGOS_API_KEY=your_secret_argos_api_key

# Telegram Bot (Para notificação de sinais)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Discord Webhook (Para notificação de sinais)
DISCORD_WEBHOOK_URL=your_discord_webhook_url
