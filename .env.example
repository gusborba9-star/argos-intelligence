# ARGOS v5.0 — ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env and fill with your credentials

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# GOOGLE AI (GEMINI)
GOOGLE_API_KEY=your_google_api_key

# PropLine API (High-Performance Sports Data)
PROPLINE_API_KEY=your_propline_api_key

# Argos Internal API Key (Para proteger a rota /api/argos/v4)
ARGOS_API_KEY=your_secret_argos_api_key

# Telegram Bot (Dual-Channel Dispatch)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Telegram Channels (Separated by Tier)
TELEGRAM_FREE_CHANNEL_ID=your_free_channel_id    # Free tier signals
TELEGRAM_CHAT_ID=your_vip_channel_id             # VIP/WHALE tier signals

# Upstash Redis (Cache & State Management)
UPSTASH_REDIS_URL=your_upstash_redis_url
UPSTASH_REDIS_TOKEN=your_upstash_redis_token

# Payment Gateway Integration (Future)
EFI_PIX_CLIENT_ID=your_efi_client_id
EFI_PIX_CLIENT_SECRET=your_efi_client_secret
